# =============================================================================
# Apex Performance — variáveis de ambiente (EXEMPLO)
# Copie para `.env` e preencha. O `.env` real NUNCA é commitado.
# =============================================================================

# --- Supabase (frontend) -----------------------------------------------------
# Painel Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# --- Strava OAuth ------------------------------------------------------------
# https://www.strava.com/settings/api  (veja o README para o passo a passo)
# O client_id pode ir para o frontend; o client_secret SÓ no backend/Edge Function.
VITE_STRAVA_CLIENT_ID=00000
STRAVA_CLIENT_SECRET=seu-client-secret-strava
# URL de callback registrada no app do Strava (deve bater exatamente).
STRAVA_REDIRECT_URI=http://localhost:5173/auth/strava/callback

# --- Supabase (Edge Functions / backend) -------------------------------------
# Usado apenas server-side (Edge Functions). NÃO exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
