{
  "name": "apexrun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Apex Performance — conferência de dados e dashboards de treino de corrida.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "npx --yes supabase start",
    "db:reset": "npx --yes supabase db reset",
    "db:diff": "npx --yes supabase db diff",
    "db:login": "npx --yes supabase login",
    "db:link": "npx --yes supabase link",
    "db:push": "npx --yes supabase db push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "fast-xml-parser": "^5.11.0",
    "fit-file-parser": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vitest": "^4.1.10"
  }
}
