{
  "name": "apexrun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Apex Performance — conferência de dados e dashboards de treino de corrida.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.analise.json --noEmit && vite build",
    "postbuild": "node scripts/copy-analise.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.analise.json --noEmit",
    "test": "vitest run",
    "test:analise": "node scripts/test-analise.mjs",
    "engine:extract": "node scripts/extract-engine.mjs",
    "golden:capture": "node scripts/golden-capture.mjs",
    "test:app": "node scripts/smoke-analise.mjs",
    "compare:views": "node scripts/compare-views.mjs",
    "shots": "node scripts/shots.mjs",
    "db:start": "npx --yes supabase start",
    "db:reset": "npx --yes supabase db reset",
    "db:diff": "npx --yes supabase db diff",
    "db:login": "npx --yes supabase login",
    "db:link": "npx --yes supabase link",
    "db:push": "npx --yes supabase db push",
    "test:offline": "node scripts/offline-analise.mjs",
    "test:garmin": "node scripts/garmin-app.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tabler/icons-react": "^3.52.0",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.11.0",
    "fit-file-parser": "^4.1.0",
    "idb": "^8.0.4",
    "maplibre-gl": "^5.24.1",
    "mp4-muxer": "5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@garmin/fitsdk": "^21.214.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "fflate": "^0.8.2",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vitest": "^4.1.10"
  }
}
